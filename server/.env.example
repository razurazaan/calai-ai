# MongoDB connection (local or MongoDB Atlas). If unreachable in dev,
# the server falls back to a temporary in-memory database (data is lost on restart).
MONGO_URI=mongodb://127.0.0.1:27017/calai

# Any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini (food photo / text analysis). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Free-tier, image-capable model. Alternative with higher free limits: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# AI usage limits per user
AI_DAILY_SCAN_LIMIT=20
AI_SCANS_PER_MINUTE=5
AI_MAX_IMAGE_MB=4

PORT=5050
